/* ================= 全局可爱软萌风主题 ================= */
page {
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #4a3f44;
  font-size: calc(28rpx * var(--fs, 1));
  background: var(--bg);
} 

/* ---------- 浅色主题（默认） ---------- */
/* 说明：--primary / --primary-grad / --primary-soft / --primary-weak / --primary-mid
   会被每个页面根节点上的内联 style（accentStyle）覆盖，实现"换主题色后全模块统一"。
   这里写的是兜底值（默认蜜桃粉），万一变量注入失败也不会变成透明/黑色。 */

   .theme-light {
    /* 背景比原来压深一点点：卡片是纯白 + 极轻阴影，背景太浅会让卡片"贴"在底上 */
    --bg: #fdeef3;
    --card: #ffffff;             /* 卡片底色：纯白色 */
    --text: #4a3f44;             /* 正文文字：灰棕色（就是你上一段page里的文字色） */
    --sub: #9b8d95;              /* 次要文字/备注：淡灰紫，比正文浅 */
    --primary: #ff8fab;          /* 主色：浅粉色（你项目的品牌色） */
    --primary-grad: linear-gradient(135deg, #ff8fab, #ffb3c6); /* 粉渐变，按钮、装饰条用（必须写 linear-gradient，写单色就变成纯色块了） */
    --primary-soft: #ffe9f0;     /* 柔和浅粉底色，标签、提示框 */
    --primary-weak: rgba(255, 143, 171, 0.14); /* 极淡粉色透明层 */
    --primary-mid: rgba(255, 143, 171, 0.35);  /* 中等透明度粉色 */
    --primary-deep: #e07a95;     /* 深一点的粉色，hover、强调 */
    --mint: #5ebfa2;             /* 薄荷绿，辅助色（成功、完成） */
    --lavender: #a98cd0;         /* 淡紫，辅助色 */
    --butter: #e8b93a;           /* 黄油黄，警告、提醒 */
    --blue: #6fb7f0;             /* 浅蓝色，信息类 */
    --line: #f6e9ee;             /* 分割线颜色，浅粉线 */
    --shadow: 0 6rpx 24rpx rgba(255, 143, 171, 0.14); /* 柔和阴影，粉色调阴影 */
    --mask: rgba(255, 143, 171, 0.08); /* 遮罩层，极淡粉色蒙层 */
    /* 输入框底色：浅色主题下"压暗"出一个实色块，比半透明蒙层更稳定，
       不会因为卡片换底色而看不出边界 */
    --field: #fdf2f6;
    --danger: #ff6f6f;           /* 失败 / 危险（删除、错误提示） */
    --warn: #c97a1f;             /* 临期 / 提醒：比亮橙深一档，白底上对比度够 */
    /* 悬浮操作条的半透明底（配合 backdrop-filter 做毛玻璃） */
    --dock: rgba(255, 255, 255, 0.88);
    /* 正文次级色：比 --sub 深一档。--sub 在白底上约 3:1，只够大字号；
       12px 左右的中文（24rpx）必须用这个，才达到 4.5:1 */
    --text-2: #6b5c64;
    /* 卡片规格：一处定义，所有列表卡片复用，避免每页各写一套尺寸 */
    --card-r: 24rpx;      /* 卡片圆角 */
    --card-pad: 24rpx;    /* 卡片内边距 */
    --card-gap: 16rpx;    /* 卡片间距（略小于内边距，视觉上才成组） */
    --thumb: 112rpx;      /* 列表缩略图边长 */
    --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.06); /* 卡片只留一层极淡阴影 */
  }
.theme-dark {
  --bg: #2a2430;               /* 深色页面背景：暗紫灰 */
  --card: #3a323f;             /* 深色卡片底色，比背景亮一点 */
  --text: #f2e8ef;             /* 正文文字：浅米白 */
  --sub: #b3a4b2;              /* 次要文字：浅灰紫 */
  --primary: #9b78b8;          /* 深色模式主色：紫色 */
  --primary-grad: linear-gradient(135deg, #7f5f9f, #b99dd6); /* 深色版紫渐变（一定要写 linear-gradient，不然只算纯色） */
  --primary-soft: #4a3a56;     /* 深色版柔和底色（暗紫灰） */
  --primary-weak: rgba(155, 120, 184, 0.20);
  --primary-mid: rgba(155, 120, 184, 0.40);
  --primary-deep: #c3afde;     /* 深色背景上的高亮文字用浅紫 */
  --mint: #5ec4a8;
  --lavender: #a98cd0;
  --butter: #e8c53a;
  --blue: #7cb8e8;
  --line: #463c4a;             /* 深色分割线，暗线条 */
  --shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.28); /* 深色阴影，黑色阴影 */
  --mask: rgba(0, 0, 0, 0.18); /* 深色遮罩，黑蒙层 */
  /* 深色主题下输入框反过来"提亮"：用黑蒙层会像凹坑，
     这是深色 UI 的通行做法（浅色压暗、深色提亮） */
  --field: rgba(255, 255, 255, 0.06);
  --danger: #ff8585;
  --dock: rgba(58, 50, 63, 0.9);
  --text-2: #cfc2cc;      /* 深色下的正文次级色，与 #3a323f 对比度约 8:1 */
  --warn: #e8a75a;        /* 深色下临期色要提亮，否则 #c97a1f 会糊在暗底里 */
  /* 深色背景上阴影几乎不可见，卡片改用 1rpx 描边区分边界 */
  --shadow-card: none;
}
  
 

/* ---------- 页面根容器 ---------- */
.page-root {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
  padding: 24rpx 24rpx 60rpx;
  color: var(--text);
}

/* ---------- 卡片 ---------- */
.cute-card {
  background: var(--card);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
  padding: 28rpx;
  box-sizing: border-box;
}

/* ---------- 区块标题（粉色小圆点） ---------- */
.section-title {
  display: flex;
  align-items: center;
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
  margin: 36rpx 8rpx 20rpx;
}

.section-title::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 14rpx;
}

/* ---------- 主按钮 ---------- */
.btn-cute {
  background: var(--primary-grad);
  color: #fff;
  border-radius: 44rpx;
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: bold;
  line-height: 2.6;
}

.btn-cute::after {
  border: none;
}

/* ---------- 通用 cell 行 ---------- */
.cell {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
}

.cell:last-child {
  border-bottom: none;
}

.cell-icon {
  font-size: calc(34rpx * var(--fs, 1));
  margin-right: 20rpx;
}

.cell-label {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
}

.cell-value {
  margin-left: auto;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--sub);
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-arrow {
  margin-left: 12rpx;
  color: var(--sub);
  font-size: calc(30rpx * var(--fs, 1));
}

/* ---------- 空状态 ---------- */
.empty-box {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: calc(88rpx * var(--fs, 1));
}

.empty-txt {
  margin-top: 20rpx;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--sub);
}

/* ---------- 输入框 ---------- */
/* 重要：小程序 input 组件自带 height: 1.4rem 的默认样式，
   若只写 padding + box-sizing: border-box，上下内边距会挤掉内容高度，
   文字被裁掉一半。这里显式给高度，并用 line-height 做垂直居中。 */
.input-cute {
  background: var(--field, var(--mask));
  border-radius: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  box-sizing: border-box;
  /* 未聚焦时留一条透明边：聚焦时只改颜色，不会让高度跳一下 */
  border: 1rpx solid transparent;
  transition: border-color 0.16s, box-shadow 0.16s, background 0.16s;
}

/* 输入框聚焦态：小程序 input 没有 :focus，靠 bindfocus/bindblur 切这个类
   （见 components/goods-fields：focusField 记住当前在填哪个字段） */
.input-cute.is-focus {
  border-color: var(--primary-mid);
  background: var(--card);
  box-shadow: 0 0 0 4rpx var(--primary-weak);
}

/* ---------- 点击反馈 ---------- */
/* 给 <view> 加 hover-class="tap-shrink"，按下时有轻微缩放，避免"点了没反应" */
.tap-shrink {
  transform: scale(0.96);
  opacity: 0.86;
}

/* 主按钮按下态：配 hover-class="btn-hover" */
.btn-hover {
  transform: scale(0.985);
  opacity: 0.92;
}

/* ---------- 迷你「＋」新建按钮（分类 / 位置共用） ---------- */
/* 刻意做成"浅底 + 虚线边"的次级按钮：页面里只允许主提交按钮用实心渐变，
   否则一行表单里出现两个渐变块，视线会散 */
.add-mini-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 68rpx;
  padding: 0 22rpx;
  margin-left: 12rpx;
  border-radius: 20rpx;
  border: 2rpx dashed var(--primary-mid);
  background: var(--primary-weak);
  color: var(--primary-deep);
  font-size: calc(25rpx * var(--fs, 1));
  font-weight: bold;
  text-align: center;
  box-sizing: border-box;
  transition: transform 0.15s, opacity 0.15s;
}

/* ---------- 多行输入（textarea，需与 input-cute 搭配使用） ---------- */
/* textarea 必须恢复自适应高度，否则会被上面的一行高度限制住 */
.area {
  height: auto;
  min-height: 160rpx;
  line-height: 1.6;
  padding: 22rpx 24rpx;
}

/* ---------- 小标签 ---------- */
.tag-cute {
  display: inline-block;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--primary);
  background: var(--primary-soft);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

/* ---------- 提示文字 ---------- */
.sub-txt {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--sub);
}

/* ---------- 页脚提示（全局通用；各页只需覆盖 margin-top / font-size） ---------- */
.footer-tip {
  text-align: center;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--sub);
}

/* ---------- 页面顶部说明块（hero）：各页只覆盖背景 / 阴影 / 字号差异 ---------- */
.hero {
  display: flex;
  align-items: center;
  border-radius: 32rpx;
  padding: 30rpx 32rpx;
}

.hero-emoji {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(44rpx * var(--fs, 1));
  margin-right: 22rpx;
  flex-shrink: 0;
}

.hero-text {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: bold;
  color: #fff;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: calc(22rpx * var(--fs, 1));
  color: rgba(255, 255, 255, 0.9);
}
