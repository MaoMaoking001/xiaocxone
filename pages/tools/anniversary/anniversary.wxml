<!--pages/tools/anniversary/anniversary.wxml 纪念日提醒 -->
<view class="page-root {{theme}}" style="{{bgStyle}}{{accentStyle}}">

<!-- 添加纪念日 -->
<view class="cute-card">
  <view class="form-head">
    <view class="form-label">{{editingId ? '✏️ 编辑纪念日' : '🎂 记住重要的日子'}}</view>
    <text wx:if="{{editingId}}" class="form-cancel" bindtap="cancelEdit">取消编辑</text>
  </view>
  <input class="input-cute title-input" placeholder="如：妈妈生日、在一起纪念日"
         value="{{title}}" bindinput="onTitle" />

  <picker class="date-picker" mode="date" value="{{date}}" bindchange="onDate">
    <view class="input-cute picker-value">
      📅 {{date || '选择日期'}}
      <text class="cell-arrow">›</text>
    </view>
  </picker>

  <view class="unit-label">提醒频率</view>
  <view class="unit-row">
    <view class="unit-tab {{cycle === 'year' ? 'active' : ''}}" bindtap="onCycle" data-k="year">每年</view>
    <view class="unit-tab {{cycle === 'month' ? 'active' : ''}}" bindtap="onCycle" data-k="month">每月</view>
    <view class="unit-tab {{cycle === 'day' ? 'active' : ''}}" bindtap="onCycle" data-k="day">每 N 天</view>
  </view>

  <view wx:if="{{cycle === 'day'}}" class="interval-row">
    <text class="interval-label">每隔</text>
    <input class="input-cute interval-input" type="number" value="{{interval}}" bindinput="onInterval" />
    <text class="interval-label">天提醒一次</text>
  </view>

  <button class="btn-cute add-btn" bindtap="add">{{editingId ? '保存修改' : '＋ 添加'}}</button>
</view>

<!-- 纪念日列表（按倒计时排序） -->
<view class="section-title">重要日子 ⏳</view>

<block wx:if="{{list.length > 0}}">
  <view class="cute-card anniv-item {{item.isToday ? 'today' : ''}} {{editingId === item.id ? 'editing' : ''}}"
        wx:for="{{list}}" wx:key="id"
        bindlongpress="onItemLongPress" data-id="{{item.id}}">
    <view class="anniv-icon">{{item.isToday ? '🎉' : '🎂'}}</view>
    <view class="anniv-main">
      <view class="anniv-title">{{item.title}}</view>
      <view class="anniv-sub">{{item.date}} · {{item.isToday ? '就是今天' : item.ruleText}}</view>
      <view class="anniv-sub" wx:if="{{item.totalDays > 0}}">已是第 {{item.totalDays}} 天</view>
    </view>
    <view class="anniv-days">
      <block wx:if="{{item.isToday}}">
        <view class="days-num">今天</view>
        <view class="days-txt">就是这一天 💗</view>
      </block>
      <block wx:else>
        <view class="days-num">{{item.days}}</view>
        <view class="days-txt">天后</view>
      </block>
    </view>
  </view>
</block>

<view wx:else class="empty-box">
  <view class="empty-icon">🎈</view>
  <view class="empty-txt">还没有纪念日，添加一个吧～</view>
</view>

<view class="footer-tip">长按卡片可以编辑或删除 🌟</view>

</view>
