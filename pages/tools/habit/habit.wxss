/* pages/tools/habit/habit.wxss */

.form-label {
  font-size: calc(26rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
  margin-bottom: 16rpx;
}

.row-between {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.name-input {
  flex: 1;
}

.icon-pick {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: var(--mask);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(44rpx * var(--fs, 1));
  flex-shrink: 0;
}

.add-btn {
  margin-top: 20rpx;
  line-height: 2.4;
}

/* ===== 习惯项 ===== */
.habit-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 20rpx;
}

.habit-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--mask);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(44rpx * var(--fs, 1));
  flex-shrink: 0;
}

.habit-main {
  flex: 1;
  min-width: 0;
}

.habit-name {
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.habit-streak {
  margin-top: 8rpx;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--primary);
}

.check-btn {
  flex-shrink: 0;
  padding: 12rpx 30rpx;
  border-radius: 36rpx;
  font-size: calc(24rpx * var(--fs, 1));
  background: var(--primary-grad);
  color: #fff;
  font-weight: bold;
}

.check-btn.checked {
  background: var(--mask);
  color: var(--sub);
  font-weight: normal;
}

.footer-tip {
  margin-top: 32rpx;
}
