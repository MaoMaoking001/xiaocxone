<!--pages/tools/habit/habit.wxml 习惯打卡 -->
<view class="page-root {{theme}}" style="{{bgStyle}}{{accentStyle}}">

<!-- 添加习惯 -->
<view class="cute-card">
  <view class="form-label">🌱 养成一个好习惯</view>
  <view class="row-between">
    <input class="input-cute name-input" placeholder="如：早睡、喝水、背单词"
           value="{{name}}" bindinput="onName" confirm-type="done" bindconfirm="add" />
    <picker range="{{icons}}" value="{{iconIndex}}" bindchange="onIcon">
      <view class="icon-pick">{{icons[iconIndex]}}</view>
    </picker>
  </view>
  <button class="btn-cute add-btn" bindtap="add">＋ 添加习惯</button>
</view>

<!-- 习惯列表 -->
<view class="section-title">今日打卡 ✅</view>

<block wx:if="{{habits.length > 0}}">
  <view class="cute-card habit-item" wx:for="{{habits}}" wx:key="id"
        bindlongpress="del" data-id="{{item.id}}">
    <view class="habit-icon">{{item.icon}}</view>
    <view class="habit-main">
      <view class="habit-name">{{item.name}}</view>
      <view class="habit-streak">🔥 已连续打卡 {{item.streak}} 天</view>
    </view>
    <view class="check-btn {{item.days[today] ? 'checked' : ''}}"
          bindtap="checkIn" data-id="{{item.id}}">
      {{item.days[today] ? '已打卡' : '打卡'}}
    </view>
  </view>
</block>

<view wx:else class="empty-box">
  <view class="empty-icon">🌻</view>
  <view class="empty-txt">还没有习惯，从今天开始养成吧～</view>
</view>

<view class="footer-tip">长按习惯卡片可以删除 🌿</view>

</view>
