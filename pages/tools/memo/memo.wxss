/* pages/tools/memo/memo.wxss 备忘录（随手记 + 每日心情打卡） */

/* ===== 写备忘（页面主角） ===== */
.write-card {
  margin-top: 8rpx;
}

.write-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.write-title {
  font-size: calc(32rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
}

.write-date {
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--sub);
}

.write-cancel {
  font-size: calc(23rpx * var(--fs, 1));
  color: var(--primary-deep, #e07a95);
  text-decoration: underline;
}

.write-cancel:active {
  opacity: 0.7;
}

.title-input {
  margin-bottom: 16rpx;
}

.memo-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 150rpx;
}

/* 心情：一行低调的开关，展开才出现表情 */
.mood-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: var(--primary-weak, rgba(255, 143, 171, 0.12));
  font-size: calc(25rpx * var(--fs, 1));
  color: var(--primary-deep, #e07a95);
}

.mood-toggle:active {
  opacity: 0.75;
}

.mood-toggle-txt {
  flex: 1;
  min-width: 0;
}

.mood-toggle-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: calc(22rpx * var(--fs, 1));
  opacity: 0.8;
}

.mood-panel {
  margin-top: 8rpx;
}

/* ===== 备忘列表 ===== */
.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 40rpx 8rpx 16rpx;
}

.list-title {
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
}

.list-count {
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--sub);
}

.memo-item {
  margin-bottom: 20rpx;
}

/* 正在编辑的那一条：描边提示 */
.memo-item.editing {
  border: 3rpx solid var(--primary, #ff8fab);
}

.memo-title {
  margin-bottom: 8rpx;
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
  word-break: break-all;
}

.memo-content {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  line-height: 1.7;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

/* 时间 + 心情：底部一行，心情弱化处理 */
.memo-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.memo-time {
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--sub);
}

.memo-mood {
  flex-shrink: 0;
  margin-left: auto;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: calc(21rpx * var(--fs, 1));
  white-space: nowrap;
}

.footer-tip {
  margin-top: 32rpx;
}

/* ===== 心情表情选择 ===== */
.mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
  margin: 24rpx 0 8rpx;
}

.mood-item {
  border-radius: 20rpx;
  text-align: center;
  padding: 16rpx 4rpx;
  border: 3rpx solid var(--line);
  background: var(--card);
  transition: transform 0.15s;
}

.mood-item:active {
  transform: scale(0.94);
}

.mood-item.active {
  box-shadow: 0 6rpx 18rpx var(--primary-mid, rgba(255, 143, 171, 0.35));
}

/* 展开 / 收起全部表情 */
.mood-more {
  margin-top: 18rpx;
  text-align: center;
  font-size: calc(23rpx * var(--fs, 1));
  color: var(--primary-deep, #e07a95);
  background: var(--primary-weak, rgba(255, 143, 171, 0.12));
  padding: 14rpx 0;
  border-radius: 20rpx;
}

.mood-more:active {
  opacity: 0.7;
}

.mood-emoji {
  font-size: calc(46rpx * var(--fs, 1));
  line-height: 1.1;
}

.mood-label {
  margin-top: 4rpx;
  font-size: calc(21rpx * var(--fs, 1));
  color: var(--sub);
}

.mood-item.active .mood-label {
  color: #fff;
}

.save-btn {
  margin-top: 24rpx;
}

/* ===== 心情记录行 ===== */
.mood-row {
  display: flex;
  align-items: center;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.mood-row:last-child {
  border-bottom: none;
}

.mood-row-emoji {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(34rpx * var(--fs, 1));
  flex-shrink: 0;
}

.mood-row-main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.mood-row-title {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
}

.mood-row-note {
  margin-top: 6rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mood-row-del {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary-weak, rgba(255, 143, 171, 0.12));
  color: var(--primary, #ff8fab);
  font-size: calc(30rpx * var(--fs, 1));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mood-row-time {
  margin-left: 10rpx;
  font-size: calc(21rpx * var(--fs, 1));
  font-weight: normal;
  color: var(--sub);
}

/* ===== 心情日历（折叠，属次要功能） ===== */
.cal-card {
  margin-top: 12rpx;
}

.cal-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cal-toggle:active {
  opacity: 0.75;
}

.cal-toggle-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
}

.cal-toggle-title {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
}

.cal-toggle-sub {
  margin-left: 14rpx;
  font-size: calc(21rpx * var(--fs, 1));
  color: var(--sub);
}

.cal-toggle-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: calc(23rpx * var(--fs, 1));
  color: var(--primary, #ff8fab);
}

.cal-body {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line);
}

.cal-clear {
  margin-top: 28rpx;
  text-align: center;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--sub);
  text-decoration: underline;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0 8rpx;
}

.cal-nav {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--primary-weak, rgba(255, 143, 171, 0.12));
  color: var(--primary, #ff8fab);
  font-size: calc(34rpx * var(--fs, 1));
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-title {
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
}

.cal-hint {
  margin: 0 0 16rpx;
  line-height: 1.6;
}

.cal-week {
  display: flex;
  margin-bottom: 8rpx;
}

.wk-cell {
  flex: 1;
  text-align: center;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--sub);
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.2857%;
  height: 124rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
}

.cal-cell.blank {
  visibility: hidden;
}

.cal-day {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text);
}

/* 每一天展示当天的情绪表情（最多 3 个并排） */
.cal-emojis {
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.cal-emoji {
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1;
}

.cal-count {
  position: absolute;
  bottom: 2rpx;
  right: 4rpx;
  font-size: calc(17rpx * var(--fs, 1));
  color: var(--primary, #ff8fab);
}

/* ===== 日历内某一天的全部记录 ===== */
.day-panel {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line);
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.day-title {
  font-size: calc(27rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
}

.day-count {
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--primary, #ff8fab);
}

.day-empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: calc(23rpx * var(--fs, 1));
  color: var(--sub);
}

.cal-cell.has {
  background: var(--primary-soft, #ffe9f0);
}

.cal-cell.today {
  outline: 3rpx solid var(--primary);
}

.cal-cell.selected {
  background: var(--primary, #ff8fab);
}

.cal-cell.selected .cal-day,
.cal-cell.selected .cal-count {
  color: #fff;
}
