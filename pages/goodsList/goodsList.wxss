/* pages/goodsList/goodsList.wxss 列表可爱风 */

/* ===== 顶部工具栏 ===== */
.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
  align-items: center;
}

.search-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--card);
  border-radius: 44rpx;
  box-shadow: var(--shadow);
  padding: 0 28rpx;
  font-size: calc(26rpx * var(--fs, 1));
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text);
}

.add-btn {
  margin: 0;
  width: 150rpx;
  height: 76rpx;              /* 和搜索框等高，视觉上对齐 */
  line-height: 76rpx;
  font-size: calc(26rpx * var(--fs, 1));
  padding: 0;
  flex-shrink: 0;
  border-radius: 999rpx;
}

/* ===== 物品卡片 ===== */
/* 尺寸/圆角/阴影全部走 app.wxss 的 token，改一处全列表生效；
   卡片间距 16rpx 比内边距 24rpx 略小，视觉上才成"组" */
.goods-card {
  margin-bottom: var(--card-gap, 16rpx);
  padding: var(--card-pad, 24rpx);
  border-radius: var(--card-r, 24rpx);
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.04));
}

/* 深色背景上阴影几乎看不见，改成一圈描边来区分卡片边界 */
.theme-dark .goods-card {
  border: 1rpx solid var(--line);
}

.goods-head {
  display: flex;
  align-items: flex-start;      /* 缩略图与文字顶部对齐，不随内容高度居中 */
  gap: 20rpx;
  transition: transform 0.15s, opacity 0.15s;
}

/* 整卡可点（进编辑页），按下时给一点反馈，不然用户不知道能点 */
.card-hover {
  transform: scale(0.995);
  opacity: 0.92;
}

.goods-img {
  width: var(--thumb, 112rpx);
  height: var(--thumb, 112rpx);
  border-radius: 16rpx;
  flex-shrink: 0;
}

.goods-main {
  flex: 1;
  min-width: 0;
}

.goods-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;                 /* 角标变多（数量/状态/到期）时换行，不挤压名称 */
  gap: 8rpx 10rpx;
  margin-bottom: 6rpx;
}

.goods-name {
  max-width: 100%;
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: 600;
  line-height: 1.35;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 第二行：位置在左、到期日在右。
   位置过长自己省略，到期日固定不换行 —— 之前几项挤在一个 flex-wrap 里，
   日期一多就会被折成两行，看着像两句互不相干的话 */
.goods-line {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 6rpx;
}

/* 用 --text-2 而不是 --sub：24rpx 的字在白底上才有 4.5:1 对比度 */
.goods-place {
  flex: 1;
  min-width: 0;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text-2, #6b5c64);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 没填位置只是提示，弱化到 --sub，不和真实数据同权重 */
.goods-place.empty {
  color: var(--sub);
}

.goods-expiry {
  flex-shrink: 0;
  white-space: nowrap;           /* 日期不能被挤成两段 */
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--sub);
  font-variant-numeric: tabular-nums;
}

.goods-expiry.expired {
  color: var(--danger, #f06a6a);
}

.goods-expiry.soon {
  color: var(--warn, #c97a1f);
}

/* 第三行：购买日 · 价格 · 存放天数（JS 里已经拼成一句，这里只管省略） */
.goods-sub {
  margin-top: 4rpx;
  font-size: calc(23rpx * var(--fs, 1));
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

/* 备注移到卡片底部通栏：右列不再是 4~5 行，缩略图和文字高度才对得上 */
.goods-remark {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--line);
  font-size: calc(23rpx * var(--fs, 1));
  line-height: 1.5;
  color: var(--sub);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ===== 分类标签配色：4 组色调 ===== */
/* 暖（衣物/美妆/零食）、冷（数码/药品）、中性（书籍/文具/家居），
   自建分类落回主色。只分 4 组是为了"能区分大类"又不花 */
.tag-cute.tone-warm {
  background: rgba(255, 170, 120, 0.20);
  color: #b3612a;
}

.tag-cute.tone-cool {
  background: rgba(110, 170, 230, 0.20);
  color: #2f6f9f;
}

.tag-cute.tone-neutral {
  background: rgba(140, 195, 165, 0.22);
  color: #3f7d63;
}

.tag-cute.tone-main {
  background: var(--primary-soft);
  color: var(--primary-deep);
}

/* 深色下底色要压暗、文字要提亮，否则彩色标签在 #3a323f 上发灰 */
.theme-dark .tag-cute.tone-warm {
  background: rgba(255, 170, 120, 0.18);
  color: #ffc39a;
}

.theme-dark .tag-cute.tone-cool {
  background: rgba(110, 170, 230, 0.18);
  color: #a8d3f5;
}

.theme-dark .tag-cute.tone-neutral {
  background: rgba(140, 195, 165, 0.18);
  color: #a9dcc4;
}

/* ===== 卡片操作：右侧竖排文字按钮 ===== */
/* 不再占整行，卡片高度基本由信息决定；文字比图标更明确，也不用担心 emoji 渲染差异 */
.goods-actions {
  flex-shrink: 0;
  align-self: center;      /* 垂直居中，不再贴着第一行顶部 */
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.act-btn {
  min-width: 84rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  background: var(--mask);
  color: var(--text-2, #6b5c64);
  font-size: calc(22rpx * var(--fs, 1));
  line-height: 1.3;
  text-align: center;
  box-sizing: border-box;
  transition: transform 0.15s, opacity 0.15s;
}

/* 删除：底色再淡一档，只靠文字颜色区分，两个色块不会抢卡片内容 */
.act-btn.warn {
  background: rgba(240, 106, 106, 0.10);
  color: var(--danger, #f06a6a);
}

/* ===== 状态提示 ===== */
.state-tip {
  text-align: center;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--sub);
  padding: 24rpx 0;
}

/* ===== 保质期提醒卡 ===== */
.remind-card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  border-left: 8rpx solid #ffb35e;
}

.remind-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.remind-title {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
}

.remind-set {
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--primary, #ff8fab);
}

.remind-sum {
  display: flex;
  gap: 18rpx;
  margin: 12rpx 0 6rpx;
  font-size: calc(22rpx * var(--fs, 1));
}

.remind-sum-i.danger { color: var(--danger, #f06a6a); }
.remind-sum-i.warn { color: var(--warn, #c97a1f); }

.remind-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
}

.remind-main {
  flex: 1;
  min-width: 0;
}

.remind-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.remind-name {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text);
}

.remind-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: calc(22rpx * var(--fs, 1));
}

.remind-tag.expired {
  background: rgba(240, 106, 106, 0.14);
  color: var(--danger, #f06a6a);
}

.remind-tag.soon {
  background: rgba(255, 179, 94, 0.18);
  color: var(--warn, #c97a1f);
}

.remind-meta {
  margin-top: 6rpx;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--text-2, #6b5c64);
}

.remind-ignore {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--mask);
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--sub);
}

.remind-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: calc(23rpx * var(--fs, 1));
  color: var(--primary, #ff8fab);
}

/* 没有「查看全部」时也要靠右：flex 只有一个子元素时 space-between 会靠左 */
.remind-ignore-all {
  margin-left: auto;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: var(--mask);
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--sub);
}

/* ===== 统计卡 ===== */
.stat-panel {
  display: block;
  padding: 24rpx 24rpx 14rpx;
  margin-bottom: 20rpx;
  background: var(--primary-weak, rgba(255, 143, 171, 0.14));
}

.sp-row {
  display: flex;
  align-items: center;
}

/* 卡底一行小字：筛选提示 + 提醒设置，不再单独占一行 */
.sp-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
  /* 这句是"数字可点"的唯一提示，20rpx 太小，读到的人不会去点 */
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--text-2, #6b5c64);
}

.sp-col {
  flex: 1;
  text-align: center;
  padding: 6rpx 0;
  border-radius: 18rpx;
}

/* 当前按到期状态筛选时，这一栏高亮，用户知道自己在"筛选模式"里 */
.sp-col.on {
  background: var(--mask);
  box-shadow: inset 0 0 0 2rpx var(--primary, #ff8fab);
}

.stat-set {
  color: var(--primary, #ff8fab);
  font-weight: bold;
}

.sp-num {
  font-size: calc(40rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
}

.sp-num.soon {
  color: var(--warn, #c97a1f);
}

.sp-num.expired {
  color: var(--danger, #f06a6a);
}

.sp-txt {
  margin-top: 8rpx;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--sub);
}

.sp-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--line);
}

/* ===== 筛选摘要（首屏只占一行） ===== */
.filter-summary {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 4rpx 18rpx;
}

.fs-main {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.fs-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  padding: 8rpx 16rpx 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-weak, rgba(255, 143, 171, 0.14));
  color: var(--primary-deep, #e07a95);
  font-size: calc(22rpx * var(--fs, 1));
}

.fs-chip-txt {
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fs-chip-x {
  margin-left: 8rpx;
  font-size: calc(24rpx * var(--fs, 1));
  opacity: 0.75;
}

.fs-empty {
  color: var(--sub);
  font-size: calc(23rpx * var(--fs, 1));
}

.fs-open {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--card);
  color: var(--sub);
  font-size: calc(23rpx * var(--fs, 1));
  box-shadow: var(--shadow);
}

.fs-count {
  margin-left: 8rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--primary, #ff8fab);
  color: #fff;
  font-size: calc(18rpx * var(--fs, 1));
}

/* ===== 筛选面板（底部弹层） ===== */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(0, 0, 0, 0.35);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.22s ease;
}

.sheet.open {
  transform: translateY(0);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.sheet-title {
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
}

.sheet-close {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--sub);
}

.sheet-body {
  flex: 1;
  /* flex 子项要设 min-height: 0 才能在自己内部滚动，
     否则内容一多会把面板撑高、滚不动 */
  min-height: 0;
  padding: 0 32rpx 32rpx;
  box-sizing: border-box;
}

.sheet-sec {
  margin-bottom: 28rpx;
}

.sec-title {
  margin-bottom: 14rpx;
  font-size: calc(24rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
}

.sec-sub {
  margin-left: 10rpx;
  font-size: calc(20rpx * var(--fs, 1));
  font-weight: normal;
  color: var(--sub);
}

/* 位置候选：最上留一点间距，复用 .chip-wrap 的换行布局 */
.place-chips {
  margin-top: 14rpx;
}

/* 三级路径可能很长：固定胶囊高度 + 单行省略号，长短不一也不会把行距撑乱 */
.place-chip {
  max-width: 100%;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: calc(23rpx * var(--fs, 1));
  background: var(--mask);
  color: var(--sub);
}

.chip.active {
  background: var(--primary, #ff8fab);
  color: #fff;
  font-weight: bold;
}

.chip.new {
  background: transparent;
  border: 2rpx dashed var(--primary, #ff8fab);
  color: var(--primary, #ff8fab);
}

.chip-empty {
  margin-top: 12rpx;
  font-size: calc(21rpx * var(--fs, 1));
  color: var(--sub);
  line-height: 1.6;
}

/* 输入框和「清除」并排：清除做成右侧的小胶囊，保证一直看得见、点得到 */
.draft-input-row {
  display: flex;
  align-items: center;
}

.draft-input-row .input-cute {
  flex: 1;
  min-width: 0;
}

.draft-clear {
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: var(--mask);
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--primary-deep, #e07a95);
}

.sheet-foot {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx 28rpx;
  border-top: 1rpx solid var(--line);
}

.sheet-reset,
.sheet-apply {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: calc(26rpx * var(--fs, 1));
}

.sheet-reset {
  background: var(--mask);
  color: var(--sub);
}

.sheet-apply {
  background: var(--primary-grad, linear-gradient(135deg, #ff8fab, #ffb3c6));
  color: #fff;
  font-weight: bold;
}

.sort-tip {
  margin: -6rpx 8rpx 16rpx;
  font-size: calc(20rpx * var(--fs, 1));
  color: var(--sub);
}

/* ===== 卡片角标 ===== */
/* 分类标签在卡片里跟其他角标对齐：同高、胶囊、间距交给父级 gap */
.goods-name-row .tag-cute {
  margin-right: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.4;
}

/* 角标统一成一种规格：22rpx / 4rpx 14rpx，只靠底色区分语义，
   字号再小（20rpx≈10px）在手机上就不好认了 */
.tag-expired,
.tag-soon,
.tag-qty,
.tag-status {
  flex-shrink: 0;
  font-size: calc(22rpx * var(--fs, 1));
  line-height: 1.4;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.tag-expired {
  background: rgba(240, 106, 106, 0.14);
  color: var(--danger, #f06a6a);
}

/* 临期用深一档的橙，原来 #e89b3c 在白底上对比度不足 3:1 */
.tag-soon {
  background: rgba(255, 179, 94, 0.18);
  color: var(--warn, #c97a1f);
}

.tag-qty {
  background: var(--mask);
  color: var(--text-2, #6b5c64);
}

.tag-status {
  background: var(--mask);
  color: var(--sub);
}

/* 已用完 / 已送人 / 已丢弃：整张卡片淡化，但内容仍然可查。
   名称加删除线，别只靠"变淡"这一种视觉线索来表达状态 */
.goods-card.inactive {
  opacity: 0.72;
}

.goods-card.inactive .goods-name {
  text-decoration: line-through;
}

.img-empty {
  background: var(--primary-soft, #ffe9f0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(44rpx * var(--fs, 1));
}

/* 空列表的出口按钮：至少让用户一键把条件清掉 */
.empty-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 26rpx;
}

.empty-btn {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: var(--primary-weak);
  color: var(--primary-deep, #e07a95);
  font-size: calc(24rpx * var(--fs, 1));
}

/* ===== 大屏适配 ===== */
/* 平板上 rpx 会整体放大，卡片会被拉成很宽的横条；
   限制内容宽度并居中，一行的阅读长度才舒服 */
@media (min-width: 768px) {
  .page-root {
    max-width: 620px;
    margin: 0 auto;
  }
}

/* 底部避开 Home 指示条，最后一张卡不会被挡住 */
.page-root {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
