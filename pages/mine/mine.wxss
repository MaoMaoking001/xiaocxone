/* pages/mine/mine.wxss 个人中心可爱风 */

/* ===== 资料卡片 ===== */
.profile-card {
  padding: 36rpx 32rpx;
}

.profile-body {
  display: flex;
  align-items: center;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid var(--primary-soft);
  flex-shrink: 0;
}

/* 默认头像：不用图片，用主题色圆形 + 🐰，深色模式下也不会出现白底 */
.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--primary-weak);
  font-size: calc(66rpx * var(--fs, 1));
  line-height: 1;
}

.profile-info {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.nickname {
  font-size: calc(38rpx * var(--fs, 1));
  font-weight: bold;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tags-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.signature {
  margin-top: 14rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-btn {
  flex-shrink: 0;
  background: var(--primary-grad);
  color: #fff;
  font-size: calc(24rpx * var(--fs, 1));
  border-radius: 30rpx;
  padding: 10rpx 26rpx;
}

.edit-btn:active {
  transform: scale(0.95);
}

/* ===== 反馈按钮（样式与 cell 一致） ===== */
.cell-btn {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
  background: transparent;
  border-radius: 0;
  margin: 0;
  line-height: inherit;
  font-size: inherit;
  text-align: left;
}

.cell-btn::after {
  border: none;
}

/* 单元格右侧的次要文字（值） */
.cell-value {
  margin-left: auto;
  margin-right: 12rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--sub);
}

/* ===== 字体大小档位 ===== */
.font-opts {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.font-opt {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--mask);
  color: var(--sub);
  font-size: calc(22rpx * var(--fs, 1));
  line-height: 1.3;
}

.font-opt.active {
  background: var(--primary-grad);
  color: #fff;
  font-weight: bold;
}

/* ===== 主题开关 ===== */
.theme-switch {
  margin-left: auto;
  transform: scale(0.8);
}

/* ===== 底部 ===== */
.footer-tip {
  margin-top: 48rpx;
}
