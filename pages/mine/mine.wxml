<!--pages/mine/mine.wxml 个人中心 -->
<view class="page-root {{theme}}" style="{{bgStyle}}{{accentStyle}}">

<!-- 顶部资料卡片：头像 + 昵称 + 编辑按钮 -->
<view class="cute-card profile-card">
  <view class="profile-body">
    <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar avatar-ph">🐰</view>
    <view class="profile-info">
      <view class="nickname">{{userInfo.nickname || '小小收纳家'}}</view>
      <view class="tags-row">
        <text class="tag-cute">{{genderText}}</text>
        <text class="tag-cute" wx:if="{{userInfo.region}}">📍{{userInfo.region}}</text>
      </view>
      <view class="signature" wx:if="{{userInfo.signature}}">「{{userInfo.signature}}」</view>
    </view>
    <view class="edit-btn" bindtap="goEdit">✏️ 编辑</view>
  </view>
</view>

<!-- 个性化 -->
<view class="section-title">个性化</view>
<view class="cute-card">
  <view class="cell" bindtap="goBg">
    <text class="cell-icon">🎨</text>
    <text class="cell-label">自定义背景</text>
    <text class="cell-arrow">›</text>
  </view>

  <!-- 深色模式：开了以后所有页面换成深色配色（存本地，重开还在） -->
  <view class="cell">
    <text class="cell-icon">{{isDark ? '🌙' : '☀️'}}</text>
    <text class="cell-label">深色模式</text>
    <switch class="theme-switch" checked="{{isDark}}" color="{{accent}}" bindchange="onThemeChange" />
  </view>

  <!-- 字体大小：照顾眼神不好的用户，整页文字一起放大 -->
  <view class="cell">
    <text class="cell-icon">🔠</text>
    <text class="cell-label">字体大小</text>
    <view class="font-opts">
      <text wx:for="{{fontOptions}}" wx:key="key"
            class="font-opt {{fontScale === item.key ? 'active' : ''}}"
            bindtap="changeFont" data-size="{{item.key}}">{{item.name}}</text>
    </view>
  </view>
</view>

<!-- 更多（隐藏工具已在首页；意见反馈 / 开发者邮箱已并入「联系开发者」） -->
<view class="section-title">更多 </view>
<view class="cute-card">
  <!-- 1. 联系开发者（含开发者邮箱 + 意见反馈，直达开发者邮箱） -->
  <view class="cell" bindtap="goFeedback">
    <text class="cell-icon">💌</text>
    <text class="cell-label">联系开发者（反馈建议）</text>
    <text class="cell-arrow">›</text>
  </view>

  <!-- 2. 清除本地缓存 -->
  <view class="cell" bindtap="clearCache">
    <text class="cell-icon">🧹</text>
    <text class="cell-label">清除本地缓存</text>
    <text class="cell-arrow">›</text>
  </view>

  <!-- 3. 数据备份与恢复 -->
  <view class="cell" bindtap="showBackup">
    <text class="cell-icon">💾</text>
    <text class="cell-label">数据备份与恢复</text>
    <text class="cell-arrow">›</text>
  </view>

  <!-- 4. 推荐给好友（原生分享） -->
  <button class="cell-btn" open-type="share">
    <text class="cell-icon">💖</text>
    <text class="cell-label">推荐给好友</text>
    <text class="cell-arrow">›</text>
  </button>

  <!-- 5. 隐私说明 -->
  <view class="cell" bindtap="showPrivacy">
    <text class="cell-icon">🛡️</text>
    <text class="cell-label">隐私说明</text>
    <text class="cell-arrow">›</text>
  </view>

  <!-- 6. 关于小程序（使用帮助已合并进来） -->
  <view class="cell" bindtap="showAbout">
    <text class="cell-icon">ℹ️</text>
    <text class="cell-label">关于小程序</text>
    <text class="cell-arrow">›</text>
  </view>

  <!-- 7. 版权声明 -->
  <view class="cell" bindtap="showCopyright">
    <text class="cell-icon">📜</text>
    <text class="cell-label">版权声明</text>
    <text class="cell-arrow">›</text>
  </view>

</view>

<view class="footer-tip">记忆收纳管家 v{{version}} · 用心记录每一件小事 🌷</view>

</view>